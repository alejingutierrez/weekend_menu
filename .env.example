# Username allowed to log in to /admin.
ADMIN_USER=admin

# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# IMPORTANT: bcrypt hashes contain `$` chars that dotenv-expand interprets
# as variable references and silently strips. Always escape every `$` with
# a backslash in .env.local when using dotenv-expand. Vercel receives the literal
# bcrypt hash without those escape characters. Local example:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abc...xyz
ADMIN_PASSWORD_HASH=

# 32+ char secret for administrator sessions and legacy Blob decryption.
# Current QR/Wallet tokens are retained permanently in the database. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Change this nonsecret version and redeploy to revoke all administrator sessions.
ADMIN_SESSION_VERSION=1
# Preserve the old value here before changing SESSION_SECRET, if legacy Blob
# files still need decryption. No production session-key rotation is required now.
LOYALTY_LEGACY_BLOB_SECRET=
# Production uses the separately provisioned weekend_runtime role on the original
# Neon endpoint. Provider-managed DATABASE_URL remains an operator fallback.
LOYALTY_DATABASE_URL=

# ── Loyalty / Wallet ────────────────────────────────────────────────
# Public origin, used to build wallet barcodes and QR codes. In dev it
# is auto-detected from the request; set it in production.
PUBLIC_BASE_URL=https://weekend-menu.vercel.app

# ── Google Wallet (Fase 2) — see SETUP-WALLET.md ────────────────────
# Issuer id from the Google Pay & Wallet Console.
GOOGLE_WALLET_ISSUER_ID=
# Loyalty class id (e.g. <issuerId>.weekend_club).
GOOGLE_WALLET_CLASS_ID=
# Service account JSON, base64-encoded (single line). Generate with:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_WALLET_SERVICE_ACCOUNT=

# ── Apple Wallet (Fase 3) — see SETUP-WALLET.md ─────────────────────
# From your Apple Developer account.
APPLE_PASS_TYPE_ID=pass.com.weekendburger.loyalty
APPLE_TEAM_ID=
# Pass signing certificate (.p12) and its password, base64-encoded.
APPLE_PASS_CERT=
APPLE_PASS_CERT_PASSWORD=
# Apple WWDR intermediate certificate (.pem), base64-encoded.
APPLE_WWDR_CERT=
# Wallet pushes use the pass certificate above; no APNs .p8 is required.
# Dedicated 64-character hexadecimal AES-256 key for encrypted recovery backups.
LOYALTY_BACKUP_KEY=
# Dedicated random secret for authenticated backup/Wallet cron jobs.
CRON_SECRET=
