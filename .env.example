# Username allowed to log in to /admin.
ADMIN_USER=admin

# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# IMPORTANT: bcrypt hashes contain `$` chars that dotenv-expand interprets
# as variable references and silently strips. Always escape every `$` with
# a backslash, in BOTH .env.local and Vercel project env vars. Example:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abc...xyz
ADMIN_PASSWORD_HASH=

# 32+ char hex string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
