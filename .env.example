# Username allowed to log in to /admin.
ADMIN_USER=admin

# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# IMPORTANT: wrap the value in SINGLE QUOTES — bcrypt hashes contain `$`
# characters that dotenv would otherwise treat as variable expansions.
ADMIN_PASSWORD_HASH=''

# 32+ char hex string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
